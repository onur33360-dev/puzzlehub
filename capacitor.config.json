{
  "appId": "com.skyroonlabs.slyswipe",
  "appName": "SlySwipe",
  "webDir": "www",
  "android": {
    "backgroundColor": "#14142E",
    "allowMixedContent": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 3000,
      "launchAutoHide": false,
      "backgroundColor": "#14142E",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
