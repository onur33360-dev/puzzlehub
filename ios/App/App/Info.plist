<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>SlySwipe</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- ================= DIL LISTESI =================
	     App Store'un "bu uygulama su dilleri destekliyor" satiri BU
	     anahtardan okunuyor; uygulamanin kendi i18n calisma zamani
	     (core/i18n.js) App Store'a gorunmez. Android tarafindaki
	     res/xml/locales_config.xml'in iOS karsiligi.

	     locales/ klasoruyle AYNI 15 kod, ayni sirada. Biri eklenirse
	     ikisi birden guncellenmeli — tools/i18n-test.js kanonik seti
	     locales/en.js'ten okuyor, buradan degil, yani bu liste sessizce
	     geride kalabilir.                                              -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>en</string>
		<string>tr</string>
		<string>de</string>
		<string>fr</string>
		<string>es</string>
		<string>it</string>
		<string>pt-BR</string>
		<string>pl</string>
		<string>ru</string>
		<string>ar</string>
		<string>hi</string>
		<string>id</string>
		<string>ja</string>
		<string>ko</string>
		<string>zh-Hans</string>
	</array>

	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>

	<!-- Capacitor sablonu buraya armv7 yaziyor. iOS 14 tabanli bir
	     uygulamada armv7 diye bir cihaz YOK (32-bit destek iOS 11'de
	     bitti); dogru deger arm64.                                     -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>

	<!-- ================= YONELIM =================
	     Uygulama DIKEY'e kilitli. Sablon yataylari da aciyordu; birakmak
	     iOS'ta Android'dekinden daha kotu olurdu, cunku Yilan'in 15x26
	     izgarasi, Flappy'nin dunya birimi ve Akis Baglanti'nin boyuna
	     dikdortgen tahtasi dikey oranlara gore olculdu.

	     ~ipad da dikey: Android 16 tarafinda >=600dp ekranlarda yonelim
	     kilidinin yok sayilmasi ACIK BIR RISK olarak kayitli ve tablet
	     davranisi orada TEST EDILMEMIS durumda. iOS'ta ayni bosluga
	     bilerek girmiyoruz.                                            -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>

	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<!-- ================= SIFRELEME BEYANI =================
	     Bu anahtar olmadan App Store Connect her yuklemede "ihracat
	     uyumlulugu" sorusunu soruyor ve build o cevap verilene kadar
	     TestFlight'ta beklemede kaliyor — yani Codemagic'ten cikan
	     otomatik yukleme elle mudahale olmadan tamamlanmiyor.
	     Uygulama yalniz standart HTTPS kullaniyor, ozel sifreleme yok. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- ================= REKLAM =================
	     BIZIM iOS AdMob uygulama kimligimiz (2026-09-05). Onceki deger
	     Google'in demo kimligiydi, cunku iOS'ta reklam kapaliydi.

	     Bu anahtar bos birakilamaz: Google Mobile Ads iOS SDK'si acilista
	     onu ariyor ve bulamazsa istisna firlatip uygulamayi DUSURUYOR.

	     Uygulama kimligi (~) ile birim kimlikleri (/) AYNI YAYINCIYA ait
	     olmak zorunda — burada pub-9211142655536364, core/app.js'teki
	     AD_IDS.ios ile ayni. Karistirmanin belirtisi sinsi: uygulama acilir,
	     hata vermez, reklam hic dolmaz.

	     Android'in yayincisi (pub-5960894143182893) BASKA ve bu normal;
	     iki platform ayri AdMob uygulamalaridir.                        -->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-9211142655536364~4012978726</string>

	<!-- ATT (App Tracking Transparency).
	     Bu metin kullaniciya SISTEM diyalogunda gosteriliyor.

	     Anahtar zorunlu, ama diyalogu UYGULAMA ACMIYOR: AdMob panelinde
	     yayinlanan IDFA mesaji ATT akisini UMP uzerinden yonetiyor. Kodda
	     requestTrackingAuthorization cagrisi YOK ve olmamali — iki ayri
	     yerden ATT istemek kullaniciya iki diyalog gosterirdi.

	     Yine de anahtarsiz birakilamaz: UMP izni istedigi anda, anahtar
	     yoksa iOS uygulamayi ANINDA sonlandiriyor.

	     TODO: InfoPlist.strings ile 15 dile cevrilmeli — uygulamanin kendi
	     i18n calisma zamani bu sistem diyalogunu kapsamiyor.            -->
	<key>NSUserTrackingUsageDescription</key>
	<string>SlySwipe uses your device identifier to show more relevant ads and measure advertising performance.</string>
</dict>
</plist>
