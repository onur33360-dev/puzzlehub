<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!--
            BUYUK EKRANDA YON KILIDI MUAFIYETI (Android 16 / API 36).
            API 36'yi hedefleyen uygulamalarda platform, 600dp ve uzeri
            ekranlarda screenOrientation, yeniden boyutlanabilirlik ve
            en boy orani kisitlarini YOK SAYIYOR. Bu uygulama dikey
            tasarlandi (yerlesim matrisi de yalnizca dikey genislikleri
            tariyor), yani tablette yatayda dogru gorunmez.

            Bu ozellik, Google'in bu davranis icin verdigi gecici muafiyet.
            DOGRULANMADI: elimizde tablet AVD yok, yalnizca telefon
            emulatoru kuruldu. Derlemeyi etkilemiyor (tanimadigi bir
            property'yi platform yok sayar), ama "tablette dikey kaldi"
            diye rapor edilmis bir olcum de YOK. Tablet destegi ayri bir
            is; o yapilana kadar buradaki niyet kayitli kalsin.
        -->
        <property
            android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY"
            android:value="true" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>

        <!--
            AdMob uygulama kimligi (GERCEK, 2026-08-07).
            Yayinci kismi core/app.js'teki AD_IDS ile AYNI olmak zorunda:
            pub-5960894143182893. Bir yayincinin birim kimligi baska bir
            yayincinin uygulama kimligi altinda SESSIZCE basarisiz olur;
            uygulama calisir, hata vermez, reklamlar hic dolmaz.
            tools/ad-release-test.js bu tutarliligi denetliyor.

            Kendi cihazimizin gercek reklam gormemesini saglayan sey bu
            dosya degil, core/app.js'teki AD_TEST_DEVICES listesi.
            Not: XML yorumu icinde cift tire KULLANILAMAZ (colors.xml dersi).
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-5960894143182893~1883487916" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
</manifest>
