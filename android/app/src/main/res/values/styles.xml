<?xml version="1.0" encoding="utf-8"?>
<!--
  Capacitor'un urettigi varsayilan tema ".Light" idi: uygulama koyu
  ama sistem cubuklari acik gri kaliyordu ve telefonda yamali
  gorunuyordu. Koyu temaya cevrildi.

  windowLightStatusBar=false SART: durum cubugu arka planini
  koyulastirmak ikonlari otomatik beyaz YAPMAZ. Bunu yazmazsak
  koyu zemin uzerinde koyu gri saat/pil ikonlari kalir ve saat
  neredeyse okunmaz olur.
-->
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:statusBarColor">@color/phBackground</item>
        <item name="android:navigationBarColor">@color/phBackground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">@color/phBackground</item>
        <item name="android:navigationBarColor">@color/phBackground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="android:statusBarColor">@color/phBackground</item>
        <item name="android:navigationBarColor">@color/phBackground</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
